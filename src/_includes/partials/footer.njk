<footer class="site-footer">
  <div class="container site-footer__inner">
    <div class="site-footer__brand">
      <img src="/assets/img/logo-reversed.svg" alt="{{ site.name }}" width="220" height="62">
      <p>Friendly, results-focused social media marketing for growing businesses.</p>
    </div>
    <nav class="site-footer__nav" aria-label="Footer">
      <ul>
        <li><a href="/">Home</a></li>
        {% for item in site.nav %}
        <li><a href="{{ item.url }}">{{ item.label }}</a></li>
        {% endfor %}
      </ul>
    </nav>
    <div class="site-footer__contact">
      <p class="label">Get in touch</p>
      <p><a href="/contact/">Send us a message</a></p>
      <ul class="social-links" aria-label="Social media">
        {% for s in site.social %}
        <li>
          <a href="{{ s.url }}" rel="me noopener" target="_blank" title="{{ site.name }} on {{ s.name }}">
            {% if s.name == "Facebook" %}<svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true" focusable="false"><path fill="currentColor" d="M24 12.07C24 5.41 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.1 10.13 24v-8.44H7.08v-3.49h3.04V9.41c0-3.02 1.8-4.7 4.54-4.7 1.31 0 2.68.24 2.68.24v2.97h-1.5c-1.5 0-1.96.93-1.96 1.89v2.26h3.33l-.53 3.49h-2.8V24C19.62 23.1 24 18.1 24 12.07z"/></svg>{% endif %}
            <span class="visually-hidden">{{ s.name }} (opens in a new tab)</span>
          </a>
        </li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container site-footer__legal">
    <p>
      <span>&copy; {{ "" | year }} {{ site.legalName }}. All rights reserved.</span>
      <span class="site-footer__sep" aria-hidden="true">|</span>
      <a href="/privacy-policy/"{% if page.url == "/privacy-policy/" %} aria-current="page"{% endif %}>Privacy Policy</a>
      <span class="site-footer__sep" aria-hidden="true">|</span>
      <a href="/terms-of-service/"{% if page.url == "/terms-of-service/" %} aria-current="page"{% endif %}>Terms of Service</a>
    </p>
  </div>
</footer>
