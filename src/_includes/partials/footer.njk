<footer class="site-footer">
  <div class="container site-footer__inner">
    <div class="site-footer__brand">
      <img src="/assets/img/logo-reversed.svg" alt="{{ site.name }}" width="220" height="62">
      <p>Friendly, results-focused social media marketing for growing businesses.</p>
    </div>
    <nav class="site-footer__nav" aria-label="Footer">
      <ul>
        <li><a href="/">Home</a></li>
        {% for item in site.nav %}
        <li><a href="{{ item.url }}">{{ item.label }}</a></li>
        {% endfor %}
      </ul>
    </nav>
    <div class="site-footer__contact">
      <p class="label">Get in touch</p>
      <p><a href="/contact/">Send us a message</a></p>
    </div>
  </div>
  <div class="container site-footer__legal">
    <p>&copy; {{ "" | year }} {{ site.legalName }}. All rights reserved.</p>
    <ul class="site-footer__legal-links">
      <li><a href="/privacy-policy/"{% if page.url == "/privacy-policy/" %} aria-current="page"{% endif %}>Privacy Policy</a></li>
      <li><a href="/terms-of-service/"{% if page.url == "/terms-of-service/" %} aria-current="page"{% endif %}>Terms of Service</a></li>
    </ul>
  </div>
</footer>
