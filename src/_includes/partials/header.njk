<header class="site-header">
  <div class="container site-header__inner">
    <a class="site-header__logo" href="/" aria-label="{{ site.name }} home">
      <img src="/assets/img/logo.svg" alt="{{ site.name }}" width="220" height="62">
    </a>
    <nav class="site-nav" aria-label="Main">
      <ul>
        {% for item in site.nav %}
        <li><a href="{{ item.url }}"{% if page.url == item.url %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
        {% endfor %}
      </ul>
    </nav>
    <a class="button button--primary site-header__cta" href="/contact/">Book a free call</a>
  </div>
</header>
